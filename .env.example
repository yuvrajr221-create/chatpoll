# Twitch Developer application and broadcaster user token
TWITCH_CLIENT_ID=
TWITCH_USER_TOKEN=
TWITCH_BROADCASTER_ID=

# Exact Channel Points reward title ChatPoll should recognize (case-insensitive)
BONUS_REWARD_TITLE=Bonus Vote

# Number of bonus votes per redemption or subscription (each gift in a gift batch)
BONUS_VOTES=1

# Optional EventSub endpoint override (normally leave unset)
# EVENTSUB_URL=wss://eventsub.wss.twitch.tv/ws
